# ============================================================
#  БОТ ТОРГОВЫХ СИГНАЛОВ — установочная конфигурация
#
#  Этот файл заполняет тот, кто ставит бота на сервер, — один раз.
#  Пользователю сюда заходить не нужно: за чем следить, как часто
#  присылать сигналы и сколько рисковать, он выбирает кнопками
#  прямо в Telegram.
# ============================================================

# ------------------------------------------------------------
# ОБЯЗАТЕЛЬНО
# ------------------------------------------------------------

# Токен бота. Получить: @BotFather -> /newbot
BOT_TOKEN=

# Telegram id того, кому приходят сигналы.
# Узнать: пусть напишет @userinfobot.
# Несколько получателей — через запятую: 111111,222222
OWNER_IDS=

# ------------------------------------------------------------
# РЫНОК
# ------------------------------------------------------------

# Любая биржа из поддерживаемых ccxt: okx, binance, bybit, gateio...
# Торговые ключи НЕ нужны: бот только читает котировки.
EXCHANGE=okx

# Прокси, если биржа недоступна с сервера напрямую.
# Пример: http://user:pass@host:port
EXCHANGE_PROXY=

# За чем следить при первом запуске. Дальше это меняется в боте:
# «Настройки» -> «За чем следить».
SYMBOLS=XAU/USDT:USDT

# Ключ сессии Pocket Option — только если нужны бинарные опционы.
# Его можно (и удобнее) прислать прямо в бот: «Настройки» ->
# «За чем следить» -> «Подключить опционы».
PO_SSID=

# ------------------------------------------------------------
# МИНИ-ПРИЛОЖЕНИЕ (необязательно)
#
# Приложение открывается кнопкой в боте и показывает то же самое
# наглядно. Telegram открывает его только по HTTPS, поэтому нужен
# домен и реверс-прокси (образец: deploy/nginx-vhost.conf).
#
# Оставьте WEBAPP_URL пустым — кнопки приложения просто не появятся,
# бот при этом работает полностью.
# ------------------------------------------------------------

WEBAPP_URL=

# Куда публиковать порт приложения для прокси.
# 127.0.0.1 — прокси на этом же хосте; в интернет порт не светится.
BIND_HOST=127.0.0.1
BIND_PORT=8097

# Внутри контейнера менять не нужно
API_HOST=0.0.0.0
API_PORT=8080

# Отключает проверку подписи Telegram, чтобы открыть приложение
# в обычном браузере при разработке. В рабочем режиме ОБЯЗАТЕЛЬНО false —
# иначе сигналы увидит любой, кто узнает адрес.
WEBAPP_DEV_MODE=false

# ------------------------------------------------------------
# СИСТЕМА
# ------------------------------------------------------------

# Часовой пояс для времени в сообщениях
TIMEZONE=Europe/Moscow

# Во сколько присылать итоги дня. Если за день сигналов не было,
# сводка не приходит вовсе.
DAILY_REPORT_AT=21:00

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

DB_PATH=data/signals.db

# ------------------------------------------------------------
# СТРАТЕГИЯ (менять не обязательно)
#
# Это стартовые значения на первый запуск с пустой базой. Дальше
# их задаёт режим работы, выбранный в боте: «Осторожный»,
# «Обычный» или «Частые сигналы».
# ------------------------------------------------------------

# SYMBOLS уже задан выше
# TIMEFRAME=15m
# HTF_TIMEFRAME=1h
# SCAN_INTERVAL=60
# MIN_CONFIDENCE=60
# MAX_SIGNALS_PER_DAY=10
# COOLDOWN_MIN=45
# SIGNAL_TTL_MIN=240
# ADX_MIN=20
# ATR_SL_MULT=1.5
# RISK_REWARD=1.8
# PO_EXPIRY_MIN=5
# PO_MIN_PAYOUT=70
