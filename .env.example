# ============================================================
#  TRADING SIGNALS BOT — установочная конфигурация
#
#  Этот файл заполняет РАЗРАБОТЧИК один раз при установке.
#  Заказчик сюда не заходит: инструменты, таймфреймы, пороги,
#  риск, фильтр новостей и уведомления он меняет прямо в
#  Telegram — в Mini App на вкладке «Настройки».
#
#  Значения ниже используются только при ПЕРВОМ запуске,
#  как стартовые. Дальше они хранятся в базе.
# ============================================================

# ------------------------------------------------------------
# ОБЯЗАТЕЛЬНО
# ------------------------------------------------------------

# Токен бота. Получить: @BotFather -> /newbot
BOT_TOKEN=

# Telegram id заказчика — кому приходят сигналы.
# Узнать: пусть напишет @userinfobot.
# Несколько получателей — через запятую: 111111,222222
OWNER_IDS=

# Домен для Mini App. A-запись домена должна указывать на IP сервера.
# Caddy сам получит сертификат Let's Encrypt для него.
DOMAIN=traiding-bot.example.ru

# Адрес Mini App — это https:// + тот же домен.
# Оставьте пустым, если Mini App пока не нужен: бот будет
# работать через обычные сообщения.
WEBAPP_URL=https://traiding-bot.example.ru

# ------------------------------------------------------------
# БИРЖА
# ------------------------------------------------------------

# Любая из поддерживаемых ccxt: okx, binance, bybit, gateio, kucoin...
# Торговые ключи НЕ нужны: бот только читает котировки.
EXCHANGE=okx

# Прокси, если биржа недоступна с сервера напрямую.
# Пример: http://user:pass@host:port
EXCHANGE_PROXY=

# ------------------------------------------------------------
# СИСТЕМА
# ------------------------------------------------------------

# Часовой пояс для времени в сообщениях и сводках
TIMEZONE=Europe/Moscow

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

DB_PATH=data/signals.db
API_HOST=0.0.0.0
API_PORT=8080

# Отключает проверку подписи Telegram, чтобы открыть Mini App
# в обычном браузере при разработке.
# В рабочем режиме ОБЯЗАТЕЛЬНО false — иначе сигналы заказчика
# увидит любой, кто узнает адрес.
WEBAPP_DEV_MODE=false

# ============================================================
#  СТАРТОВЫЕ ЗНАЧЕНИЯ НАСТРОЕК
#  Применяются только при первом запуске с пустой базой.
#  Потом всё это заказчик меняет сам в Mini App.
# ============================================================

SYMBOLS=XAU/USDT:USDT
TIMEFRAME=15m
HTF_TIMEFRAME=1h
SCAN_INTERVAL=60

MIN_CONFIDENCE=60
MAX_SIGNALS_PER_DAY=0
TRADE_HOURS=
REQUIRE_HTF_AGREE=true
REQUIRE_VOLUME=false
ADX_MIN=20
COOLDOWN_MIN=45
SIGNAL_TTL_MIN=240

ATR_SL_MULT=1.5
RISK_REWARD=1.8

EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
EMA_TREND_SLOW=200
RSI_PERIOD=14
RSI_LONG_MIN=45
RSI_LONG_MAX=72
RSI_SHORT_MIN=28
RSI_SHORT_MAX=55
ADX_PERIOD=14
ATR_PERIOD=14

# --- Бинарные опционы (необязательно) ---
# SSID сессии Pocket Option. Заказчик задаёт его сам в Mini App,
# здесь — только стартовое значение.
PO_SSID=
PO_EXPIRY_MIN=5
PO_MIN_PAYOUT=70
PO_OTC_ONLY=false

NEWS_FILTER_ENABLED=true
NEWS_MUTE_BEFORE_MIN=30
NEWS_MUTE_AFTER_MIN=15
NEWS_CURRENCIES=USD
NEWS_IMPACT=High

DAILY_REPORT_AT=21:00
