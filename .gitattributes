# Во всём репозитории одни окончания строк — LF.
# Без этого правки с Windows-машины превращали каждый файл в «изменён
# целиком», и в истории тонули настоящие изменения.
* text=auto eol=lf

# Бинарные и сторонние файлы не трогаем
*.png binary
*.jpg binary
*.exe binary
app/api/webapp/vendor/* -text
